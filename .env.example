# ── LLM Backend Selection ──────────────────────────────────
# OLLAMA_INFRA=True
# THINK_ENABLED=false

# # ── Model Configuration ───────────────────────────────────
# # Defaults to 'ornith' if not specified. 
# # You can change this to 'llama3', 'mistral', 'qwen', etc.
# REASONING_MODEL=ornith
# META_PROMPT_MODEL=ornith
# TESTER_MODEL=ornith
# SUMMARY_MODEL=ornith
# EMBEDDING_MODEL=nomic-embed-text/
# ── Optional Backend Overrides ────────────────────────────
# OLLAMA_BASE_URL=http://localhost:11434
# LLAMACPP_MODELS_DIR=models
# LLAMACPP_N_CTX=8192
# LLAMACPP_N_GPU_LAYERS=-1