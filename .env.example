# ── LLM Backend Selection ──────────────────────────────────
OLLAMA_INFRA=False
THINK_ENABLED=false

# ── Model Configuration ───────────────────────────────────
REASONING_MODEL=ornith
META_PROMPT_MODEL=ornith
TESTER_MODEL=ornith
SUMMARY_MODEL=ornith
EMBEDDING_MODEL=nomic-embed-text

# ── Temperature Configuration (0.0 = deterministic, 1.0 = creative) ──
REASONING_TEMP=0.7
META_PROMPT_TEMP=0.2
TESTER_TEMP=0.3
SUMMARY_TEMP=0.3
GOAL_TEMP=0.2

# ── llama.cpp Backend Overrides ──────────────────────────
LLAMACPP_MODELS_DIR=./llms
LLAMACPP_N_CTX=256000
LLAMACPP_N_GPU_LAYERS=-1
LLAMACPP_N_THREADS=4